<?xml version="1.0" encoding="UTF-8"?>
<!--
  Update Set export representing the "Book Request" table.
  Table name: u_book_request
  Extends: sys_metadata (standard custom table)
-->
<unload unload_date="2026-07-05">

  <!-- ===================== TABLE DEFINITION ===================== -->
  <sys_db_object action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <label>Book Request</label>
    <is_extendable>false</is_extendable>
    <sys_class_name>sys_db_object</sys_class_name>
    <access>public</access>
    <create_access>true</create_access>
    <read_access>true</read_access>
    <update_access>true</update_access>
    <delete_access>true</delete_access>
  </sys_db_object>

  <!-- ===================== FIELD: Requested Book (reference) ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_requested_book</element>
    <column_label>Requested Book</column_label>
    <internal_type>reference</internal_type>
    <reference>u_library_book</reference>
    <mandatory>true</mandatory>
  </sys_dictionary>

  <!-- ===================== FIELD: Requested By (reference to sys_user) ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_requested_by</element>
    <column_label>Requested By</column_label>
    <internal_type>reference</internal_type>
    <reference>sys_user</reference>
    <mandatory>true</mandatory>
    <default_value>javascript:gs.getUserID()</default_value>
  </sys_dictionary>

  <!-- ===================== FIELD: Request Status (choice) ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_request_status</element>
    <column_label>Request Status</column_label>
    <internal_type>string</internal_type>
    <max_length>20</max_length>
    <choice>1</choice>
    <default_value>pending</default_value>
    <mandatory>true</mandatory>
  </sys_dictionary>
  <sys_choice action="INSERT_OR_UPDATE"><name>u_book_request</name><element>u_request_status</element><label>Pending</label><value>pending</value><sequence>100</sequence></sys_choice>
  <sys_choice action="INSERT_OR_UPDATE"><name>u_book_request</name><element>u_request_status</element><label>Approved</label><value>approved</value><sequence>200</sequence></sys_choice>
  <sys_choice action="INSERT_OR_UPDATE"><name>u_book_request</name><element>u_request_status</element><label>Rejected</label><value>rejected</value><sequence>300</sequence></sys_choice>
  <sys_choice action="INSERT_OR_UPDATE"><name>u_book_request</name><element>u_request_status</element><label>Returned</label><value>returned</value><sequence>400</sequence></sys_choice>

  <!-- ===================== FIELD: Request Date ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_request_date</element>
    <column_label>Request Date</column_label>
    <internal_type>glide_date_time</internal_type>
    <default_value>javascript:gs.nowDateTime()</default_value>
    <mandatory>true</mandatory>
    <read_only>true</read_only>
  </sys_dictionary>

  <!-- ===================== FIELD: Return Date ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_return_date</element>
    <column_label>Return Date</column_label>
    <internal_type>glide_date_time</internal_type>
    <mandatory>false</mandatory>
  </sys_dictionary>

  <!-- ===================== FIELD: Approved/Rejected By (reference, set by workflow) ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_processed_by</element>
    <column_label>Processed By (Librarian)</column_label>
    <internal_type>reference</internal_type>
    <reference>sys_user</reference>
    <read_only>true</read_only>
  </sys_dictionary>

  <!-- ===================== FIELD: Rejection Reason ===================== -->
  <sys_dictionary action="INSERT_OR_UPDATE">
    <name>u_book_request</name>
    <element>u_rejection_reason</element>
    <column_label>Rejection Reason</column_label>
    <internal_type>string</internal_type>
    <max_length>500</max_length>
  </sys_dictionary>

</unload>
